# ---------- Build stage ----------
FROM node:20-alpine AS build
WORKDIR /app

COPY package*.json ./
RUN npm ci

COPY . .
RUN npm run build -- --configuration production

# ---------- Serve stage ----------
FROM nginx:alpine

# Angular build output goes to dist/<project-name>/browser (Angular 17+ application builder)
COPY --from=build /app/dist/library-management-fe/browser /usr/share/nginx/html

# Custom nginx config for Angular routing (handles refresh on client-side routes)
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]